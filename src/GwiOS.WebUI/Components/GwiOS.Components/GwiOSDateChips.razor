<div class="gwios-chip-row" role="group" aria-label="@AriaLabel">
    @foreach ((string label, int daysAgo) in RelativeDays)
    {
        DateOnly date = Today.AddDays(-daysAgo);
        <button type="button"
                class="gwios-chip @(Value == date ? "gwios-chip--selected" : null)"
                aria-pressed="@(Value == date ? "true" : "false")"
                @onclick="() => SelectAsync(date)">
            @label
        </button>
    }
    @if (RecentDate is DateOnly recentDate && IsRecentDateChipShown)
    {
        <button type="button"
                class="gwios-chip @(Value == recentDate ? "gwios-chip--selected" : null)"
                title="Zuletzt eingegebenes Datum"
                aria-pressed="@(Value == recentDate ? "true" : "false")"
                @onclick="() => SelectAsync(recentDate)">
            Zuletzt @recentDate.ToString("dd.MM.")
        </button>
    }
    <span class="gwios-date-chips-custom">
        <span class="gwios-chip @(IsCustomDate ? "gwios-chip--selected" : null)" aria-hidden="true">
            @(IsCustomDate ? $"📅 {Value:dd.MM.yyyy}" : "📅")
        </span>
        <input type="date"
               class="gwios-date-chips-picker"
               value="@Value.ToString("yyyy-MM-dd")"
               aria-label="Anderes Datum wählen"
               title="Anderes Datum"
               @onchange="OnPickerChangeAsync" />
    </span>
</div>
